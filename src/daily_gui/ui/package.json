{
  "name": "audient-console-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Audient Console Daily GUI frontend (offline WebView2 presentation layer)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./app.css --minify",
    "build:js": "esbuild ./src/main.ts --bundle --format=iife --target=chrome110 --outfile=./app.js --minify",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:js && npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
